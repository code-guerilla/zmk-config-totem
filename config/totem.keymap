#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// Mouse-Geschwindigkeiten für Miryoku Mouse-Layer (VOR pointing.h definieren!)
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1300  // Flüssige Zeigergeschwindigkeit
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // Angenehmes Scrollen
#include <dt-bindings/zmk/pointing.h>

// =========================================================================
// DEUTSCHE QWERTZ-ÜBERSETZUNG FÜR WINDOWS
// (Sorgt dafür, dass Colemak-DH & US-Miryoku-Symbole unter Windows DE stimmen)
// =========================================================================
#define DE_Y    Z               // Sendet DE-'Y'
#define DE_Z    Y               // Sendet DE-'Z'
#define DE_AE   SQT             // ä / Ä
#define DE_OE   SEMI            // ö / Ö
#define DE_UE   LBKT            // ü / Ü
#define DE_SS   MINUS           // ß
#define DE_EURO RA(E)           // €

// Satzzeichen & Programmier-Symbole (auf DE-QWERTZ gemappt)
#define DE_MINS SLASH           // -
#define DE_UNDS LS(SLASH)       // _
#define DE_PLUS RBKT            // +
#define DE_STAR LS(RBKT)        // *
#define DE_EQL  LS(N0)          // =
#define DE_SLSH LS(N7)          // /
#define DE_BSLS RA(MINUS)       // \ (AltGr + ß)
#define DE_PIPE RA(NON_US_BSLH) // | (AltGr + <)
#define DE_LT   NON_US_BSLH     // <
#define DE_GT   LS(NON_US_BSLH) // >
#define DE_LPAR LS(N8)          // (
#define DE_RPAR LS(N9)          // )
#define DE_LBKT RA(N8)          // [
#define DE_RBKT RA(N9)          // ]
#define DE_LBRC RA(N7)          // {
#define DE_RBRC RA(N0)          // }
#define DE_SEMI LS(COMMA)       // ;
#define DE_COLN LS(DOT)         // :
#define DE_SQT  LS(NUHS)        // '
#define DE_DQT  LS(N2)          // "
#define DE_GRAV LS(EQUAL)       // `
#define DE_TILD RA(RBKT)        // ~
#define DE_EXCL LS(N1)          // !
#define DE_AT   RA(Q)           // @
#define DE_HASH NUHS            // #
#define DE_DLLR LS(N4)          // $
#define DE_PRCNT LS(N5)         // %
#define DE_CARET GRAVE          // ^
#define DE_AMPS LS(N6)          // &
#define DE_QMARK LS(MINUS)      // ?

// Layer-Nummern (Miryoku Standard + Umlaut-Layer)
#define BASE  0
#define NAV   1
#define MOUSE 2
#define MEDIA 3
#define NUM   4
#define SYM   5
#define FUN   6
#define UML   7

&sk {
    release-after-ms = <2000>;
    quick-release;
};

&sl {
    release-after-ms = <2000>;
};

/ {
    behaviors {
        // Optimierte "Timeless" Home Row Mods (Original Miryoku: Super, Alt, Ctrl, Shift)
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        // Daumen Layer-Tap mit Quick-Tap (Doppeltippen + Halten wiederholt z.B. Backspace/Space)
        lt_q: layer_tap_quick {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };

        // Spezial-Behavior für die 2 äußeren Pinky-Tasten:
        // Antippen = Aktiviert Umlaute für den nächsten Tastendruck (Sticky Layer)
        // Halten   = Aktiviert Umlaute solange gehalten
        uml_key: umlaut_layer_key {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&sl>;
        };

        // Korrigierter Punkt & Komma für DE-QWERTZ:
        // Normal = , / . | Mit Shift = < / > (wie im US-Miryoku Standard!)
        de_comm: de_comma_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp DE_LT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        de_dot: de_dot_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp DE_GT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        de_slsh: de_slash_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_SLSH>, <&kp DE_QMARK>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        de_sqt: de_sqt_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_SQT>, <&kp DE_DQT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // 0: BASE (Miryoku Colemak-DH: A=GUI, R=Alt, S=Ctrl, T=Shift | N=Shift, E=Ctrl, I=Alt, O=GUI)
        base_layer {
            display-name = "Base";
            bindings = <
                         &kp Q       &kp W       &kp F        &kp P        &kp B            &kp J        &kp L        &kp U        &kp DE_Y    &de_sqt
                         &hm LGUI A  &hm LALT R  &hm LCTRL S  &hm LSHFT T  &kp G            &kp M        &hm RSHFT N  &hm RCTRL E  &hm LALT I  &hm RGUI O
            &uml_key UML UML &kp DE_Z &kp X      &kp C        &kp D        &kp V            &kp K        &kp H        &de_comm     &de_dot     &de_slsh    &uml_key UML UML
                                                 &lt_q MEDIA ESC &lt_q NAV SPACE &lt_q MOUSE TAB  &lt_q SYM RET &lt_q NUM BSPC &lt_q FUN DEL
            >;
        };

        // 1: NAV (Miryoku Navigation auf der rechten Hand)
        nav_layer {
            display-name = "Nav";
            bindings = <
                         &trans      &trans      &trans       &trans       &trans           &kp K_AGAIN  &kp K_PASTE  &kp K_COPY   &kp K_CUT   &kp K_UNDO
                         &kp LGUI    &kp LALT    &kp LCTRL    &kp LSHFT    &trans           &caps_word   &kp LEFT     &kp DOWN     &kp UP      &kp RIGHT
            &trans       &trans      &trans      &trans       &trans       &trans           &kp INS      &kp HOME     &kp PG_DN    &kp PG_UP   &kp END     &trans
                                                 &trans       &trans       &trans           &kp RET      &kp BSPC     &kp DEL
            >;
        };

        // 2: MOUSE (Miryoku Mouse Navigation & Scrollen auf der rechten Hand)
        mouse_layer {
            display-name = "Mouse";
            bindings = <
                         &trans      &trans      &trans       &trans       &trans           &trans       &trans       &trans       &trans      &trans
                         &kp LGUI    &kp LALT    &kp LCTRL    &kp LSHFT    &trans           &trans       &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT
            &trans       &trans      &trans      &trans       &trans       &trans           &trans       &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT &trans
                                                 &trans       &trans       &trans           &mkp RCLK    &mkp LCLK    &mkp MCLK
            >;
        };

        // 3: MEDIA (Miryoku Media & Bluetooth-Steuerung auf der rechten Hand)
        media_layer {
            display-name = "Media";
            bindings = <
                         &trans      &trans      &trans       &trans       &trans           &out OUT_TOG &bt BT_PRV   &bt BT_NXT   &bt BT_CLR  &studio_unlock
                         &kp LGUI    &kp LALT    &kp LCTRL    &kp LSHFT    &trans           &trans       &kp C_PREV   &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT
            &trans       &trans      &trans      &trans       &trans       &trans           &trans       &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &trans
                                                 &trans       &trans       &trans           &kp C_STOP   &kp C_PP     &kp C_MUTE
            >;
        };

        // 4: NUM (Miryoku Zahlenblock auf der linken Hand)
        num_layer {
            display-name = "Num";
            bindings = <
                         &kp DE_LBKT &kp N7      &kp N8       &kp N9       &kp DE_RBKT      &trans       &trans       &trans       &trans      &trans
                         &kp DE_SEMI &kp N4      &kp N5       &kp N6       &kp DE_EQL       &trans       &kp RSHFT    &kp RCTRL    &kp LALT    &kp RGUI
            &trans       &kp DE_GRAV &kp N1      &kp N2       &kp N3       &kp DE_BSLS      &trans       &trans       &trans       &trans      &trans      &trans
                                                 &kp DOT      &kp N0       &kp DE_MINS      &trans       &trans       &trans
            >;
        };

        // 5: SYM (Miryoku Symbole auf der linken Hand, DE-QWERTZ übersetzt)
        sym_layer {
            display-name = "Sym";
            bindings = <
                         &kp DE_LBRC &kp DE_AMPS &kp DE_STAR  &kp DE_LPAR  &kp DE_RBRC      &trans       &trans       &trans       &trans      &trans
                         &kp DE_COLN &kp DE_DLLR &kp DE_PRCNT &kp DE_CARET &kp DE_PLUS      &trans       &kp RSHFT    &kp RCTRL    &kp LALT    &kp RGUI
            &trans       &kp DE_TILD &kp DE_EXCL &kp DE_AT    &kp DE_HASH  &kp DE_PIPE      &trans       &trans       &trans       &trans      &trans      &trans
                                                 &kp DE_LPAR  &kp DE_RPAR  &kp DE_UNDS      &trans       &trans       &trans
            >;
        };

        // 6: FUN (Miryoku F-Tasten auf der linken Hand)
        fun_layer {
            display-name = "Fun";
            bindings = <
                         &kp F12     &kp F7      &kp F8       &kp F9       &kp PSCRN        &trans       &trans       &trans       &trans      &trans
                         &kp F11     &kp F4      &kp F5       &kp F6       &kp SLCK         &trans       &kp RSHFT    &kp RCTRL    &kp LALT    &kp RGUI
            &trans       &kp F10     &kp F1      &kp F2       &kp F3       &kp PAUSE_BREAK  &trans       &trans       &trans       &trans      &trans      &trans
                                                 &kp K_APP    &kp SPACE    &kp TAB          &trans       &trans       &trans
            >;
        };

        // 7: UML (Deutsche Umlaute & € - aktiviert über die 2 äußeren Spezialtasten)
        uml_layer {
            display-name = "Umlaute";
            bindings = <
                         &trans      &trans      &trans       &trans       &trans           &trans       &kp DE_EURO  &kp DE_UE    &trans      &trans
                         &kp DE_AE   &kp DE_OE   &kp DE_SS    &kp DE_UE    &kp DE_EURO      &trans       &kp DE_AE    &kp DE_OE    &kp DE_UE   &kp DE_SS
            &trans       &trans      &trans      &trans       &trans       &trans           &trans       &trans       &trans       &trans      &trans      &trans
                                                 &trans       &kp LSHFT    &trans           &trans       &kp RSHFT    &trans
            >;
        };
    };
};
